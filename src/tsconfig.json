{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "moduleResolution": "bundler",
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "experimentalDecorators": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "vscode/vscode/*": [
        "./node_modules/@codingame/monaco-vscode-extension-api/vscode/src/*"
      ],
      "vscode/*": [
        "./node_modules/@codingame/monaco-vscode-extension-api/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "./**/*.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "dist",
    "dist-classic",
    "node_modules",
    "build",
    "guest",
    "offline"
  ]
}
